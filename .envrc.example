# Copy to .envrc and fill in; direnv exports these when you cd into the repo.
# `jac run` does not read .env files (TDD §3, rule 10), so the variables must be exported.
# Never commit the filled-in copy; .envrc is gitignored.

# Admin account created on first boot (defaults to admin/changeme when unset).
export ADMIN_PASSWORD=""

# OpenRouter, for every model call (#10, #12).
export OPENROUTER_API_KEY=""

# Kill switch: set to 1 to make every model call fail fast with no request, so the
# pipeline takes its deterministic fallbacks (TDD §2, principle 6).
export TRADING_AGENT_DISABLE_MODELS=""

# Alpaca paper trading and market data (#13, #18).
export ALPACA_API_KEY=""
export ALPACA_SECRET_KEY=""

# Free data sources (#22, #23, #24).
export FINNHUB_API_KEY=""
export FRED_API_KEY=""
export SEC_USER_AGENT="trading-agent team-contact@example.com"

# Optional base-URL overrides, one per source in research/sources.jac. Leave unset to call
# the real providers; tests point them at a local fake that replays recorded fixtures.
# export ALPACA_DATA_URL=""
# export ALPACA_BASE_URL=""
# export SEC_DATA_URL=""
# export SEC_ARCHIVES_URL=""
# export FINNHUB_BASE_URL=""
# export FRED_BASE_URL=""
# export WIKIPEDIA_BASE_URL=""

# Set to a directory to save every live collector response as a test fixture (CONTRIBUTING.md).
# export COLLECTOR_RECORD_DIR=""
